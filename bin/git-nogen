#!/bin/bash
# Run a git command excluding linguist-generated / linguist-vendored files.
# Uses pathspec attr-matching so all nested .gitattributes files are honored,
# instead of parsing only the top-level .gitattributes, and without having to
# enumerate every file (which blows past ARG_MAX on large repos).
#
# Usage: git-nogen <git-subcommand> [args...]
#   git-nogen show --stat
#   git-nogen diff --name-only
set -e

if [ $# -eq 0 ]; then
  echo "Usage: git-nogen <git-subcommand> [args...]" >&2
  exit 1
fi

exec git "$@" -- . \
  ':(exclude,attr:linguist-generated=true)' \
  ':(exclude,attr:linguist-vendored=true)'
